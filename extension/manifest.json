{
  "manifest_version": 3,
  "name": "AsidZ AutoFlow",
  "short_name": "AsidZ Flow",
  "description": "Batch generate videos and images on Google Flow with dock sync, character preservation, and auto-download. Official Platform: https://asidz.com",
  "version": "2.6.0",
  "action": {
    "default_title": "AsidZ AutoFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/fx/*"
      ],
      "js": [
        "scripts/page-upload.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/fx/*"
      ],
      "js": [
        "scripts/jquery.min.js",
        "scripts/selectors.js",
        "scripts/helpers.js",
        "scripts/flow.js",
        "scripts/queue.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/*",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/*"
      ]
    }
  ],
  "offline_enabled": true,
  "minimum_chrome_version": "116"
}
