{
  "manifest_version": 3,
  "name": "AsidZ AutoFlow",
  "version": "2.4.0",
  "description": "Batch videos & images on Google Flow, auto-downloaded. Powered by AsidZ CDP Automation Engine & Cloud SaaS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "debugger",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open AsidZ AutoFlow Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "scripts/cdp-automator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/*",
        "scripts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
